#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Author: O. Bayley
Description:
    This module controls the server element of the ChromTroller program. It handles
    socket communication and offloads all commands to the ChromTroller object.

    The IP address will default to the IP of the PC running the server but can be declared if
    desired. The port must be specified and should be between 1024-49151. [Ports <1024 are commonly
    used/privileged ports for Unix systems (avoid). Ports 49152-65535 are dynamic ports used by the
    operating system (avoid). Ports use an unsigned 16-bit integer, so max port is 65,535 (limit)]

    The ports and IP addresses are sensitive info and are therefore stored and loaded from the
    'protected_settings.json' file in the 'settings_files' directory, which is not tracked by version control.
"""

import socket
import threading
import logging
import json
import os
from datetime import datetime
from typing import Any, Dict, Optional

from utils.get_project_directory import get_project_dir


class Server:
    """
    The Server class handles incoming connections from clients, allowing them to control the
    LCMS controller system via the ChromTroller object.

    Attributes:
        ct_program (Any): Reference to the main ChromTroller program.
        id_file (Dict[str, Any]): Dictionary containing sensitive connection data.
        server_socket (socket.socket): The server's socket object.
        active_connection (bool): Indicates if a client is currently connected.
        active_connection_lock (threading.Lock): Lock for thread-safe access to 'active_connection'.
    """

    def __init__(self, chromtroller: Any) -> None:
        """
        Initializes the Server by loading connection data, setting up the server socket,
        and initializing thread locks.

        Args:
            chromtroller (Any): The main ChromTroller program instance.
        """
        # Reference to main controller program
        self.ct_program = chromtroller

        # Get sensitive data from settings file
        self.id_file: Dict[str, Any] = self._load_socket_info()

        # Create server socket
        self.server_socket: socket.socket = self._init_socket()

        # Connection management
        self.active_client_socket: Optional[socket.socket] = None
        self.active_connection_lock = threading.Lock()

    # ----- Initialization Methods -----

    @staticmethod
    def _load_socket_info() -> Dict[str, Any]:
        """
        Loads sensitive connection data from 'protected_settings.json'.

        Returns:
            Dict[str, Any]: Configuration dictionary with connection settings.

        Raises:
            FileNotFoundError: If the settings file is not found.
            json.JSONDecodeError: If there's an error decoding the JSON.
            PermissionError: If there's a permission error accessing the file.
        """
        try:
            settings_path = os.path.join(get_project_dir(), 'settings_files', 'protected_settings.json')
            with open(settings_path, 'r', encoding='utf-8') as ids_file:
                config = json.load(ids_file)
                logging.info("Server loaded connection IDs from JSON file successfully")
            return config
        except (FileNotFoundError, json.JSONDecodeError, PermissionError) as err:
            logging.error(f"Error loading socket info: {err}")
            raise

    def _init_socket(self) -> socket.socket:
        """
        Initializes the server socket.

        Returns:
            socket.socket: Configured server socket.

        Raises:
            socket.error: If there's an error initializing the socket.
        """
        try:
            server_socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            server_socket.bind(("", self.id_file['socket_port']))
            self._print_info(f"Server listening on port: {self.id_file['socket_port']}")
            return server_socket
        except socket.error as err:
            logging.error(f"Error initializing server socket: {err}")
            raise

    # -----Connection Methods -----

    def listen_for_new_connections(self) -> None:
        """
        Listens for incoming connections and handles them on separate threads.
        Only allows connections from authorized IP addresses.
        """
        self.server_socket.listen()
        while True:
            try:
                # Accept a new connection
                client_socket, client_addr = self.server_socket.accept()
                client_ip = client_addr[0]

                with self.active_connection_lock:
                    if self.active_client_socket is not None:
                        # Reject new connections if one is already active
                        denied_message = "Connection rejected: A client is already connected."
                        self._print_info(denied_message)
                        self._send_to_client(client_socket, denied_message, data_type='error')
                        client_socket.close()
                        continue
                    elif client_ip not in self.id_file['allowed_ips']:
                        # Reject connections from unauthorized IPs
                        denied_message = f"Connection from {client_addr} rejected: Unauthorized IP."
                        self._print_info(denied_message)
                        self._send_to_client(client_socket, denied_message, data_type='error')
                        client_socket.close()
                        continue
                    else:
                        # Accept the connection
                        self.active_client_socket = client_socket

                # Start a new thread to handle the client
                threading.Thread(target=self._handle_client, args=(client_socket,)).start()
                date_str = datetime.now().strftime("%H:%M:%S_%d-%m-%Y")
                connect_message = f"Client connected from addr: {client_ip} at {date_str}"
                self._print_info(connect_message)
                self._send_to_client(client_socket, connect_message, data_type='info')

            except socket.error as socket_error:
                logging.exception("Error accepting connections: %s", socket_error)

    def _handle_client(self, client_socket: socket.socket) -> None:
        """
        Handles communication with a connected client.

        Args:
            client_socket (socket.socket): The client's socket.
        """
        try:
            while True:
                # Receive data from the client
                client_comm_dict = self._receive_from_client(client_socket)
                if client_comm_dict is None:
                    # Client has disconnected
                    date_str = datetime.now().strftime("%H:%M:%S_%d-%m-%Y")
                    self._print_info(f"Client disconnected at {date_str}")
                    break

                # Handle the command
                response = self.ct_program.handle_command(client_comm_dict)

                # Send response back to the client
                self._send_to_client(client_socket=client_socket, data=response, data_type='reply')
                logging.info(f"Response sent to client: {response}")

        except Exception as err:
            logging.exception(f"Error handling client connection: {err}")
            self._send_to_client(client_socket, {'error': str(err)}, data_type='error')
        finally:
            client_socket.close()
            with self.active_connection_lock:
                self.active_client_socket = None

    @staticmethod
    def _send_to_client(client_socket: socket.socket, data: Any, data_type: str = 'info') -> None:
        """
        Sends data to the client in a predefined format.
        Sending format - first 4 bytes are message length followed by a keyed dict encoded as a JSON.
        Keyed Dict - {'type': data_type(str), 'data': data(Any)}

        Args:
            client_socket (socket.socket): The client's socket.
            data (Any): The data to send.
            data_type (str, optional): The type of data ('reply', 'info', 'error'). Defaults to 'info'.
        """
        try:
            message_dict = {'type': data_type, 'data': data}
            message = json.dumps(message_dict).encode()
            message_length = len(message).to_bytes(4, byteorder='big')
            client_socket.sendall(message_length + message)
        except Exception as err:
            logging.error(f"Error sending data to client {client_socket} - {err}")

    def send_info_to_client(self, data: Any) -> None:
        """
        Sends an 'info' message to the connected client so that the client can receive status updates.

        Args:
            data (Any): The data to send to the client.
        """
        with self.active_connection_lock:
            if self.active_client_socket is not None:
                try:
                    self._send_to_client(self.active_client_socket, data, data_type='info')
                    logging.info(f"Info message sent to client: {data}")
                except Exception as err:
                    logging.exception(f"Error sending info to client: {err}")
            else:
                logging.warning("No active client connection to send info message.")

    @staticmethod
    def _receive_from_client(client_socket: socket.socket) -> Optional[Dict[str, Any]]:
        """
        Receives data from the client in a predefined format.
        Receiving format - first 4 bytes are message length followed by a keyed dict encoded as a JSON.
        Keyed Dict - {'command': command(str), 'data': data(Any)}

        Args:
            client_socket (socket.socket): The client's socket.

        Returns:
            Optional[Dict[str, Any]]: The received data as a dictionary, or None if the client disconnected.
        """
        try:
            # Read the length of the incoming message (4 bytes) then read the message
            message_length_bytes = client_socket.recv(4)
            if not message_length_bytes:
                return None  # Empty data byte received so the client must have disconnected

            message_length = int.from_bytes(message_length_bytes, byteorder='big')

            # Read the message. Loop to prevent partial reads from .recv
            data = b''
            while len(data) < message_length:
                packet = client_socket.recv(message_length - len(data))
                if not packet:
                    return None  # Client disconnected during message
                data += packet

            received_dict = json.loads(data.decode())
            return received_dict

        except json.JSONDecodeError as err:
            logging.error(f"JSON decode error: {err}")
            return None

        except Exception as err:
            logging.exception(f"Error receiving data from client: {err}")
            return None

    # ----- Utility Methods -----

    @staticmethod
    def _print_info(message: str) -> None:
        """
        Logs an info message and prints it to the console.
        Allows logging.info to be used without always printing to console

        Args:
            message (str): The message to log and print.
        """
        logging.info(message)
        print(message)

