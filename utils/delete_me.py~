import json
import pandas as pd
import ast
import matplotlib.pyplot as plt
import matplotlib.colors as mcolors
import seaborn as sns


def make_df_from_json():
    path = r"C:\Users\obayley\OneDrive - UvA\Desktop\results.json"
    with open(path, 'r') as f:
        data = json.load(f)
    result_list = []
    conc_list = []
    tbuooh_eq_list = []
    nbs_eq_list = []
    rt_list = []
    intensity_list = []
    for key, value in data.items():
        result = value[0]
        key_list = ast.literal_eval(key)
        conc = key_list[1]
        tbuooh_eq = key_list[3]
        nbs_eq = key_list[5]
        rt = key_list[6]
        intensity = key_list[7]
        result_list.append(result)
        conc_list.append(conc)
        tbuooh_eq_list.append(tbuooh_eq)
        nbs_eq_list.append(nbs_eq)
        rt_list.append(rt)
        intensity_list.append(intensity)
    res_dict = {'result': result_list, 'conc': conc_list, 'tbuooh_eq': tbuooh_eq_list, 'nbs_eq': nbs_eq_list,
                'rt': rt_list, 'intensity': intensity_list}
    df = pd.DataFrame(res_dict)
    df.to_csv('test.csv', index=True)

    return df


def plot_df(df):
    sns.set_theme(style="white", palette="viridis", font_scale=1.2, font='sans-serif')
    plt.figure(figsize=(10, 6))
    sns.scatterplot(data=df,
                    x=df.index,
                    y="result",
                    hue="result",
                    palette="viridis",
                    alpha=0.9,
                    s=60,
                    legend=False)
    sns.despine()

    # Customizing the plot
    plt.title('Run Results')  # Title
    plt.xlabel('Run Count')  # X-axis label
    plt.ylabel('Raw Integral')  # Y-axis label

    # Showing the plot
    plt.tight_layout()  # Ensure labels fit within the figure
    plt.show()

if __name__ == "__main__":
    df = make_df_from_json()
    plot_df(df)
